// Prisma schema file for E-commerce System
// Compliant with PLANNING.md specifications

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentProvider {
  COD
  VNPAY
  MOMO
  STRIPE
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ProductMediaType {
  IMAGE
  VIDEO
}

enum QuestionStatus {
  PENDING
  ANSWERED
  HIDDEN
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
  CANCELLED
}

enum InventoryTransactionType {
  ADJUSTMENT
  RETURN
  SALE
  RESTOCK
}

// -------------------------------------------------------------
// USER & ADDRESS
// -------------------------------------------------------------

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String
  phone     String?
  avatar    String?
  role      Role       @default(CUSTOMER)
  isActive  Boolean    @default(true)
  addresses Address[]
  orders    Order[]
  reviews   Review[]
  wishlists Wishlist[]
  questions ProductQuestion[]
  answers ProductAnswer[]
  helpfulReviews ReviewHelpful[]
  viewEvents ProductViewEvent[]
  returns ReturnRequest[]
  cart      Cart?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("users")
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String
  phone         String
  province      String
  district      String
  ward          String
  detail        String
  isDefault     Boolean  @default(false)
  orders        Order[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

// -------------------------------------------------------------
// CATEGORY
// -------------------------------------------------------------

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  isActive    Boolean    @default(true)
  products    Product[]
  brandPromotions PromotionCategory[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("categories")
}

// -------------------------------------------------------------
// PRODUCT, VARIANTS & IMAGES
// -------------------------------------------------------------

model Product {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique
  description      String
  shortDescription String?
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId          String?
  brand            Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  basePrice        Float
  thumbnail        String?
  status           ProductStatus    @default(DRAFT)
  variants         ProductVariant[]
  images           ProductImage[]
  media            ProductMedia[]
  questions        ProductQuestion[]
  viewEvents       ProductViewEvent[]
  bundleItems      ProductBundleItem[] @relation("BundleProduct")
  componentBundles ProductBundleItem[] @relation("BundleComponent")
  promotionLinks   PromotionProduct[]
  reviews          Review[]
  wishlists        Wishlist[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([brandId])
  @@map("products")
}

model ProductVariant {
  id            String      @id @default(uuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String      @unique
  attributes    Json        @default("{}") // e.g. {"color": "Red", "size": "XL"}
  price         Float
  stockQuantity Int         @default(0)
  cartItems     CartItem[]
  orderItems    OrderItem[]
  media         ProductMedia[]
  inventoryTransactions InventoryTransaction[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

// -------------------------------------------------------------
// CART & CART ITEMS
// -------------------------------------------------------------

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique // Cho guest cart
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

// -------------------------------------------------------------
// ORDERS & ORDER ITEMS
// -------------------------------------------------------------

model Order {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  addressId     String?
  address       Address?      @relation(fields: [addressId], references: [id], onDelete: SetNull)
  status        OrderStatus   @default(PENDING)
  totalAmount   Float
  paymentMethod PaymentMethod @default(COD)
  couponId      String?
  coupon        Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      Payment[]
  returns       ReturnRequest[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("orders")
}

enum PaymentMethod {
  COD
  VNPAY
  MOMO
  STRIPE
}

model OrderItem {
  id              String         @id @default(uuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity        Int            @default(1)
  priceAtPurchase Float
  returns         ReturnItem[]
  createdAt       DateTime       @default(now())

  @@index([orderId])
  @@map("order_items")
}

// -------------------------------------------------------------
// PAYMENTS
// -------------------------------------------------------------

model Payment {
  id            String          @id @default(uuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      PaymentProvider
  transactionId String?
  status        PaymentStatus   @default(PENDING)
  amount        Float
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([orderId])
  @@map("payments")
}

// -------------------------------------------------------------
// REVIEWS
// -------------------------------------------------------------

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int      @default(5)
  comment   String?
  media     ProductReviewMedia[]
  helpful   ReviewHelpful[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId])
  @@map("reviews")
}

// -------------------------------------------------------------
// COUPONS
// -------------------------------------------------------------

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Float
  minOrderValue Float        @default(0)
  validFrom     DateTime
  validTo       DateTime
  usageLimit    Int          @default(100)
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  orders        Order[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("coupons")
}

// -------------------------------------------------------------
// WISHLIST
// -------------------------------------------------------------

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlists")
}

model Brand {
  id String @id @default(uuid())
  name String
  slug String @unique
  logoUrl String?
  isActive Boolean @default(true)
  products Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductMedia {
  id String @id @default(uuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  type ProductMediaType
  url String
  altText String?
  position Int @default(0)
  createdAt DateTime @default(now())
}

model ProductReviewMedia {
  id String @id @default(uuid())
  reviewId String
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  type ProductMediaType
  url String
  position Int @default(0)
  createdAt DateTime @default(now())
}

model ReviewHelpful {
  reviewId String
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([reviewId, userId])
}

model ProductViewEvent {
  id String @id @default(uuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?
  createdAt DateTime @default(now())
}

model ProductQuestion {
  id String @id @default(uuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  content String
  status QuestionStatus @default(PENDING)
  answers ProductAnswer[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductAnswer {
  id String @id @default(uuid())
  questionId String
  question ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  content String
  isOfficial Boolean @default(false)
  createdAt DateTime @default(now())
}

model Promotion {
  id String @id @default(uuid())
  name String
  discountType DiscountType
  discountValue Float
  startsAt DateTime
  endsAt DateTime
  priority Int @default(0)
  isActive Boolean @default(true)
  products PromotionProduct[]
  categories PromotionCategory[]
}

model PromotionProduct {
  promotionId String
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([promotionId, productId])
}

model PromotionCategory {
  promotionId String
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  categoryId String
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@id([promotionId, categoryId])
}

model ProductBundle {
  id String @id @default(uuid())
  name String
  discountType DiscountType?
  discountValue Float?
  isActive Boolean @default(true)
  items ProductBundleItem[]
}

model ProductBundleItem {
  id String @id @default(uuid())
  bundleId String
  bundle ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation("BundleProduct", fields: [productId], references: [id], onDelete: Cascade)
  componentProductId String
  componentProduct Product @relation("BundleComponent", fields: [componentProductId], references: [id], onDelete: Cascade)
  quantity Int @default(1)
}

model ShippingZone {
  id String @id @default(uuid())
  name String
  isActive Boolean @default(true)
  provinces ShippingZoneProvince[]
  rates ShippingRate[]
}

model ShippingZoneProvince {
  id String @id @default(uuid())
  provinceCode String @unique
  provinceName String
  zoneId String
  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
}

model ShippingRate {
  id String @id @default(uuid())
  zoneId String
  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name String
  fee Float
  freeFrom Float?
  minDays Int
  maxDays Int
  isActive Boolean @default(true)
}

model ReturnRequest {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason String
  status ReturnStatus @default(REQUESTED)
  items ReturnItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReturnItem {
  id String @id @default(uuid())
  returnRequestId String
  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity Int
  condition String?
}

model InventoryTransaction {
  id String @id @default(uuid())
  variantId String
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type InventoryTransactionType
  quantity Int
  referenceId String?
  note String?
  createdAt DateTime @default(now())
}
