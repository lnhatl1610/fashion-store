# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ecommerce_db"

# Server
PORT=3000
NODE_ENV=development

# Browser clients allowed to send HttpOnly auth cookies
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

# Use "none" with HTTPS when frontend and API are on different sites
AUTH_COOKIE_SAME_SITE=lax

# JWT Secrets
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production
